{
  "name": "radioso-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm run build:crawler && pnpm run build:mcp && pnpm run generate:openapi && pnpm run generate:skills && tsc -p tsconfig.json && node ./scripts/copyNonTsAssets.mjs",
    "install:crawler": "pnpm --dir ../packages/crawler install --frozen-lockfile",
    "build:crawler": "pnpm --dir ../packages/crawler run build",
    "build:mcp": "pnpm --dir ../packages/radioso-mcp-server run build",
    "dev": "pnpm run dev:http",
    "predev:http": "pnpm run build:crawler && pnpm run build:mcp",
    "dev:http": "tsx watch ./src/httpServer.ts",
    "predev:worker": "pnpm run build:crawler",
    "dev:worker": "tsx watch ./src/documentWorker.ts",
    "predev:worker-server": "pnpm run build:crawler",
    "dev:worker-server": "tsx watch ./src/documentWorkerServer.ts",
    "predev:crawler-worker": "pnpm run build:crawler",
    "dev:crawler-worker": "tsx watch ./src/crawlerWorker.ts",
    "predev:crawler-worker-server": "pnpm run build:crawler",
    "dev:crawler-worker-server": "tsx watch ./src/crawlerWorkerServer.ts",
    "generate:openapi": "tsx ./scripts/generateOpenApi.ts",
    "generate:skills": "tsx ./scripts/generateSkillContracts.ts",
    "lint": "pnpm run lint:boundaries",
    "lint:boundaries": "depcruise --config dependency-cruiser.config.cjs src",
    "start": "pnpm run start:http",
    "start:http": "node ./dist/src/httpServer.js",
    "start:worker": "node ./dist/src/documentWorker.js",
    "start:worker-server": "node ./dist/src/documentWorkerServer.js",
    "start:crawler-worker": "node ./dist/src/crawlerWorker.js",
    "start:crawler-worker-server": "node ./dist/src/crawlerWorkerServer.js",
    "test": "pnpm run build:mcp && vitest run",
    "test:unit": "pnpm run build:mcp && vitest run tests/unit",
    "test:composition": "pnpm run build:mcp && vitest run tests/unit/capability-policy.test.ts tests/unit/application-modules.test.ts tests/unit/default-composition.test.ts tests/unit/document-capability-policy.test.ts",
    "test:integration": "pnpm run build:mcp && vitest run tests/integration",
    "test:contract": "pnpm run build:mcp && pnpm run generate:openapi && node ../scripts/check-api-contracts.mjs && pnpm run generate:skills -- --check && vitest run tests/contract",
    "test:persistence": "pnpm run build:mcp && vitest run tests/integration/persistence.integration.test.ts",
    "validate:architecture": "node ../scripts/validate-architecture-boundaries.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@google-cloud/storage": "^7.17.2",
    "@google-cloud/tasks": "^5.5.0",
    "@radioso/connector-api": "workspace:*",
    "@radioso/crawler": "workspace:*",
    "@radioso/document-parser": "workspace:*",
    "@radioso/mcp-server": "workspace:*",
    "@types/swagger-ui-express": "^4.1.8",
    "amqplib": "^1.0.3",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "openai": "^6.38.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "dependency-cruiser": "^17.4.0",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "@xmldom/xmldom": "0.9.10"
  }
}
