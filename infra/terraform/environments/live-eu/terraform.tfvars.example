backend_image  = "europe-west1-docker.pkg.dev/radioso-494120/radioso-live-eu/backend:latest"
frontend_image = "europe-west1-docker.pkg.dev/radioso-494120/radioso-live-eu/frontend:latest"

# Required secrets: prefer TF_VAR_* in CI instead of committing tfvars.
# openai_api_key                 = ""
# session_cookie_secret          = ""
# workspace_token_secret        = ""
# public_chat_session_secret     = ""
# connector_encryption_key       = ""
# resend_mail_api_key            = ""
# lettermint_project_token       = ""
# mail_driver                    = "lettermint"
# posthog_api_key                = ""
# mail_from_email                = "noreply@your-verified-domain.example"
# mail_from_name                 = "Radioso"

# Primary public hostnames remain unchanged during the regional cutover.
# app_base_url_override             = "https://app.radioso.ai"
# public_chat_base_url_override     = "https://app.radioso.ai/chat"
# connector_public_base_url         = "https://api.radioso.ai"
# public_api_origin                 = "https://api.radioso.ai"
# radioso_mcp_enabled               = true
# worker_tasks_service_url_override = "https://your-eu-worker-url.a.run.app"

# Ray operator copilot
# copilot_probe_budget_per_turn       = 6    # replayed turns one Ray turn may spend verifying
# copilot_conversation_retention_days = 90   # 0 keeps Ray conversations indefinitely
# copilot_retention_schedule          = "30 4 * * *"

# --- Monitoring and alerting ---
# monitoring_enabled             = true
# monitoring_notification_emails = ["ops@your-domain.example"]
# Slack: create the channel once in Cloud Monitoring (it holds an OAuth token Terraform
# should not keep in state), then paste its ID here.
# monitoring_extra_notification_channel_ids = ["projects/YOUR_PROJECT/notificationChannels/1234567890"]
# container_health_probes_enabled = true
# monitoring_voice_turn_limit_threshold     = 5   # voice turns hitting the turn limit per 15 minutes
# monitoring_voice_abandoned_turn_threshold = 5   # voice requests closed before the outcome per 15 minutes

# --- Ops event feed ---
# Add ops_webhook to the sink lists above to push product events and errors out.
# product_analytics_sinks  = "audit,ops_webhook"
# error_sinks              = "audit,ops_webhook"
# ops_event_webhook_url    = "https://hooks.example.com/radioso"
# ops_event_webhook_secret = ""   # prefer TF_VAR_ops_event_webhook_secret in CI
# ops_event_webhook_events = "account.registered,chat.failed"
# ops_event_webhook_queue_limit = 500

# --- Email channel ---
# Unset email_channel_provider leaves the channel off. Supply secrets through TF_VAR_* in CI.
# email_channel_provider                = "resend"   # or "lettermint"
# email_channel_inbound_domain          = "inbound.your-domain.example"
# email_channel_webhook_secret          = ""   # TF_VAR_email_channel_webhook_secret
# email_channel_webhook_secret_previous = ""   # only while a rotation overlaps
# resend_channel_api_key                = ""   # unset uses resend_mail_api_key
# lettermint_team_token                 = ""   # lettermint only
# lettermint_project_id                 = ""   # lettermint only
# email_channel_workers_enabled         = true
# email_channel_sweep_schedule          = "*/5 * * * *"
