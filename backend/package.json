{
  "name": "radioso-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run generate:openapi && tsc -p tsconfig.json && node ./scripts/copyNonTsAssets.mjs",
    "dev": "tsx watch ./src/index.ts",
    "generate:openapi": "tsx ./scripts/generateOpenApi.ts",
    "start": "node ./dist/src/index.js",
    "smoke:connectors:whatsapp": "node --import tsx ./scripts/whatsappConnectorSmoke.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "npm run generate:openapi && vitest run tests/contract",
    "test:persistence": "vitest run tests/integration/persistence.integration.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.2",
    "@radioso/document-parser": "file:../packages/document-parser",
    "@radioso/connector-api": "file:../packages/connector-api",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "openai": "^5.20.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
