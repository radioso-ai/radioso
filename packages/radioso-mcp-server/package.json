{
  "name": "@radioso/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "radioso-mcp-http": "./dist/src/cli/http.js",
    "radioso-mcp-server": "./dist/src/cli/http.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --dir ../mcp-source-proof run build && pnpm --dir ../operator-mcp-contract run build && tsc -p tsconfig.build.json",
    "sync:openapi": "node --import tsx ./scripts/syncOpenApi.mjs",
    "check:openapi": "node --import tsx ./scripts/syncOpenApi.mjs --check",
    "smoke:all": "pnpm run smoke:http && pnpm run smoke:redis",
    "smoke:http": "node --import tsx ./scripts/smokeHttp.ts",
    "smoke:redis": "node --import tsx ./scripts/smokeRedis.ts",
    "test": "pnpm --dir ../mcp-source-proof test && pnpm --dir ../../backend run build:workspace-deps && vitest run"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@radioso/operator-mcp-contract": "workspace:*",
    "@radioso/mcp-source-proof": "workspace:*",
    "redis": "^4.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.22.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
