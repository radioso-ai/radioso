{
  "name": "@radioso/typescript-sdk",
  "version": "0.2.0",
  "description": "First-party TypeScript SDK for the Radioso context platform.",
  "license": "Apache-2.0",
  "homepage": "https://docs.radioso.ai/sdk/typescript-getting-started",
  "keywords": [
    "radioso",
    "sdk",
    "agents",
    "retrieval",
    "rag",
    "assistant"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "openapi/radioso.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "sync": "node ./scripts/sync-openapi.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
