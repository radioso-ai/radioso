{
  "name": "radioso-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run generate:openapi && tsc -p tsconfig.json && node ./scripts/copyNonTsAssets.mjs",
    "dev": "npm run dev:http",
    "dev:http": "tsx watch ./src/httpServer.ts",
    "dev:worker": "tsx watch ./src/documentWorker.ts",
    "dev:worker-server": "tsx watch ./src/documentWorkerServer.ts",
    "generate:openapi": "tsx ./scripts/generateOpenApi.ts",
    "lint": "npm run lint:boundaries",
    "lint:boundaries": "depcruise --config dependency-cruiser.config.cjs src",
    "start": "npm run start:http",
    "start:http": "node ./dist/src/httpServer.js",
    "start:worker": "node ./dist/src/documentWorker.js",
    "start:worker-server": "node ./dist/src/documentWorkerServer.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:composition": "vitest run tests/unit/capability-policy.test.ts tests/unit/application-modules.test.ts tests/unit/default-composition.test.ts tests/unit/document-capability-policy.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:contract": "npm run generate:openapi && vitest run tests/contract",
    "test:persistence": "vitest run tests/integration/persistence.integration.test.ts",
    "validate:architecture": "node ../scripts/validate-architecture-boundaries.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@google-cloud/storage": "^7.17.2",
    "@google-cloud/tasks": "^5.5.0",
    "@radioso/connector-api": "file:../packages/connector-api",
    "@radioso/document-parser": "file:../packages/document-parser",
    "@types/swagger-ui-express": "^4.1.8",
    "amqplib": "^1.0.3",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "openai": "^5.20.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "dependency-cruiser": "^17.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "@xmldom/xmldom": "0.9.10"
  }
}
