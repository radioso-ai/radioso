# Canonical local configuration for backend host runs, tests, and Docker Compose.
PORT=8080
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hivec
# Used only by persistence integration tests running on the host.
INTEGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hivec
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_RERANK_MODEL=gpt-4.1-mini
OPENAI_VECTOR_MODEL=text-embedding-3-small
SESSION_COOKIE_NAME=hivec_session
SESSION_COOKIE_SECRET=change-me-change-me
SESSION_TTL_HOURS=168
# Connector secret encryption key (32 bytes, base64-encoded).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_ENCRYPTION_KEY=
