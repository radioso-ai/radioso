{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Hand-derived from specification/a2a.proto on main of github.com/a2aproject/A2A (ProtoJSON, camelCase field names, oneof members as wrapper keys). A2A v1.0 publishes no JSON Schema for the card, so this file is the gate: it is written independently of the renderer's own Zod schema, so a card cannot pass by agreeing with itself. It enforces A2A v1.0 section 5.7, 'arrays marked as required MUST contain at least one element', as minItems: 1 on every field the proto marks REQUIRED and repeated (supportedInterfaces, defaultInputModes, defaultOutputModes, skills, and AgentSkill.tags). additionalProperties is false throughout so a stray v0.3 field (url, protocolVersion, preferredTransport, security, stateTransitionHistory) fails.",
  "definitions": {
    "AgentCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "supportedInterfaces",
        "version",
        "capabilities",
        "defaultInputModes",
        "defaultOutputModes",
        "skills"
      ],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "supportedInterfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/AgentInterface" }
        },
        "provider": { "$ref": "#/definitions/AgentProvider" },
        "version": { "type": "string" },
        "documentationUrl": { "type": "string" },
        "capabilities": { "$ref": "#/definitions/AgentCapabilities" },
        "securitySchemes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/SecurityScheme" }
        },
        "securityRequirements": {
          "type": "array",
          "items": { "$ref": "#/definitions/SecurityRequirement" }
        },
        "defaultInputModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "defaultOutputModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/AgentSkill" }
        },
        "signatures": {
          "type": "array",
          "items": { "$ref": "#/definitions/AgentCardSignature" }
        },
        "iconUrl": { "type": "string" }
      }
    },
    "AgentInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "protocolBinding", "protocolVersion"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "protocolBinding": { "type": "string", "minLength": 1 },
        "tenant": { "type": "string" },
        "protocolVersion": { "type": "string", "minLength": 1 }
      }
    },
    "AgentProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "organization"],
      "properties": {
        "url": { "type": "string" },
        "organization": { "type": "string" }
      }
    },
    "AgentCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streaming": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "extensions": {
          "type": "array",
          "items": { "$ref": "#/definitions/AgentExtension" }
        },
        "extendedAgentCard": { "type": "boolean" }
      }
    },
    "AgentExtension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "params": { "type": "object" }
      }
    },
    "AgentSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "examples": { "type": "array", "items": { "type": "string" } },
        "inputModes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outputModes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "securityRequirements": {
          "type": "array",
          "items": { "$ref": "#/definitions/SecurityRequirement" }
        }
      }
    },
    "AgentCardSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected", "signature"],
      "properties": {
        "protected": { "type": "string" },
        "signature": { "type": "string" },
        "header": { "type": "object" }
      }
    },
    "StringList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SecurityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/StringList" }
        }
      }
    },
    "SecurityScheme": {
      "type": "object",
      "description": "A oneof: exactly one wrapper key names the scheme.",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "apiKeySecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["location", "name"],
          "properties": {
            "description": { "type": "string" },
            "location": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "httpAuthSecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme"],
          "properties": {
            "description": { "type": "string" },
            "scheme": { "type": "string", "minLength": 1 },
            "bearerFormat": { "type": "string" }
          }
        },
        "oauth2SecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flows"],
          "properties": {
            "description": { "type": "string" },
            "flows": { "type": "object" },
            "oauth2MetadataUrl": { "type": "string" }
          }
        },
        "openIdConnectSecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openIdConnectUrl"],
          "properties": {
            "description": { "type": "string" },
            "openIdConnectUrl": { "type": "string" }
          }
        },
        "mtlsSecurityScheme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}
