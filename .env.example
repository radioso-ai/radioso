# Canonical local configuration for backend host runs, tests, and Docker Compose.
PORT=8080
NODE_ENV=development
# Number of trusted reverse-proxy hops for client IP resolution. Keep 0 unless
# the backend is behind a trusted proxy. Cloud Run behind a frontend API proxy
# is typically 1 or 2 depending on topology.
TRUST_PROXY_HOPS=0
OBSERVABILITY_ENABLED=true
OBSERVABILITY_SERVICE_NAME=radioso-api
# Defaults to NODE_ENV when unset. Keep explicit if you want nonstandard tags.
OBSERVABILITY_ENVIRONMENT=development
OBSERVABILITY_VERSION=
# Requires METRICS_AUTH_TOKEN when true.
METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional. Examples: always_on, always_off, traceidratio,
# parentbased_traceidratio.
OTEL_TRACES_SAMPLER=
# Required only for ratio samplers. Example: 0.25
OTEL_TRACES_SAMPLER_ARG=
# Optional OpenTelemetry logs export. Use an OTLP HTTP logs endpoint such as
# https://eu.i.posthog.com/i/v1/logs for PostHog EU projects. The bearer token
# should be a project token, not a personal API key.
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_AUTH_BEARER=
# Optional. Examples: debug, info, warn, error. Defaults to info.
OTEL_LOGS_MIN_LEVEL=
# Set to enterprise to load the bundled Enterprise backend module by default.
RADIOSO_EDITION=oss
# First-party persistence stays on by default. Enterprise modules may register
# additional product analytics sinks.
PRODUCT_ANALYTICS_SINKS=audit
# First-party persistence stays on by default. Enterprise modules may register
# additional error sinks.
ERROR_SINKS=audit
# Enterprise PostHog sinks use the ingestion host and project token.
POSTHOG_HOST=
POSTHOG_API_KEY=
GOOGLE_CLOUD_PROJECT=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radioso
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
# Startup SQL migrations run before the backend binds its HTTP port. These
# bounds apply to migration metadata checks so lock waits are visible in logs
# instead of silently consuming the platform startup-probe window. Migration SQL
# bodies disable these local bounds so large index builds/backfills can finish.
DB_MIGRATION_LOCK_TIMEOUT_MS=10000
DB_MIGRATION_STATEMENT_TIMEOUT_MS=25000
# Used only by persistence integration tests running on the host.
INTEGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/radioso
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_CHAT_MODEL=gpt-5.2
OPENAI_RERANK_MODEL=gpt-5.2
OPENAI_VECTOR_MODEL=text-embedding-3-small
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
# Set non-OpenAI text providers per capability as needed. Embeddings must stay
# on an OpenAI-compatible 1536-d model unless the storage contract changes.
LLM_CHAT_PROVIDER=
LLM_CHAT_MODEL=
LLM_REWRITE_PROVIDER=
LLM_REWRITE_MODEL=
LLM_RERANK_PROVIDER=
LLM_RERANK_MODEL=
LLM_EMBEDDING_PROVIDER=
LLM_EMBEDDING_MODEL=
SESSION_COOKIE_NAME=radioso_session
SESSION_COOKIE_SECRET=
# Required by Enterprise Operator Console. This is separate from SESSION_COOKIE_NAME.
STAFF_SESSION_COOKIE_NAME=radioso_staff_session
# Optional; defaults to 8 hours when unset.
STAFF_SESSION_TTL_HOURS=8
# Generated by the bootstrap command when missing.
WORKSPACE_TOKEN_SECRET=
WORKSPACE_TOKEN_SECRET_PREVIOUS=
# Generated by the bootstrap command when missing.
PUBLIC_CHAT_SESSION_SECRET=
# Generated by the bootstrap command when missing.
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=20
WORKSPACE_RATE_LIMIT_MAX_ATTEMPTS=30
# At-rest encryption key (32 bytes, base64-encoded).
# Encrypts connector secrets AND per-workspace LLM provider API keys for
# OpenAI / Anthropic / Gemini. Generated by the bootstrap command when missing.
CONNECTOR_ENCRYPTION_KEY=
# Local development only. Allows workspace webhook destinations to target
# http://localhost, 127.0.0.1, ::1, or Docker host.docker.internal. Rejected in production.
WEBHOOK_DESTINATIONS_ALLOW_HTTP_LOOPBACK=false
# Document storage backend for uploaded source files: `local` for local runs,
# `gcs` for cloud deployments.
DOCUMENT_STORAGE_DRIVER=local
# Filesystem path used when DOCUMENT_STORAGE_DRIVER=local.
DOCUMENT_STORAGE_LOCAL_PATH=../.context/document-storage
# GCS bucket used to store original uploaded document files when
# DOCUMENT_STORAGE_DRIVER=gcs.
DOCUMENT_STORAGE_BUCKET=
# Maximum accepted uploaded file size in bytes.
DOCUMENT_UPLOAD_MAX_BYTES=10485760
# Worker dispatch mode: `noop` keeps local polling behavior, `cloud-tasks`
# dispatches request-driven jobs to the worker service, and `amqp` publishes
# RabbitMQ-compatible queue notifications for document workers.
WORKER_DISPATCH_DRIVER=noop
WORKER_TASKS_QUEUE_LOCATION=
WORKER_TASKS_QUEUE_NAME=
# Optional. When unset, crawl jobs use WORKER_TASKS_QUEUE_NAME.
WORKER_TASKS_CRAWL_QUEUE_NAME=
WORKER_TASKS_SERVICE_URL=
# Optional. When unset, website crawl Cloud Tasks dispatches reuse WORKER_TASKS_SERVICE_URL.
# Set this to the dedicated crawler worker public URL when running it as a separate service.
WORKER_TASKS_CRAWL_SERVICE_URL=
WORKER_TASKS_INVOKER_SERVICE_ACCOUNT=
# Required when WORKER_DISPATCH_DRIVER=amqp.
WORKER_AMQP_URL=
WORKER_AMQP_QUEUE_NAME=
# Optional. When unset, crawl jobs use WORKER_AMQP_QUEUE_NAME.
WORKER_AMQP_CRAWL_QUEUE_NAME=
WORKER_AMQP_PREFETCH=1
# Lease window for in-flight document jobs before timed-out claims can be
# reclaimed by a later worker delivery attempt.
DOCUMENT_PROCESSING_JOB_LEASE_MS=300000
# Lease window for in-flight website crawl jobs. Crawls are browser-heavy, so
# this is intentionally longer than document processing.
WEBSITE_CRAWL_JOB_LEASE_MS=900000
WEBSITE_CRAWL_WORKER_POLL_INTERVAL_MS=5000
# Set to false to disable the website crawler. The API hides the crawl routes,
# the UI hides the "Crawl Website" button, and the crawler worker exits on
# startup so its container can be removed.
WEBSITE_CRAWLER_ENABLED=true
# Public frontend origin. Used by password reset, email verification, hosted
# links, the default origin from which the website embed launcher script is
# served, and OAuth redirect URIs. External-skill MCP OAuth uses
# APP_BASE_URL + /oauth/mcp-callback; workspace integration OAuth uses
# APP_BASE_URL + /api/v1/oauth/callback/{provider}. OAuth connections cannot be
# authorized unless this is set.
# Set RADIOSO_WIDGET_ORIGIN explicitly only when the launcher is served from a
# different origin than the dashboard (e.g., a CDN).
APP_BASE_URL=http://localhost:3000
# Customer email OAuth providers are unavailable until their client credentials
# are configured. Redirect URIs use APP_BASE_URL + /api/v1/oauth/callback/{provider}.
GOOGLE_MAIL_OAUTH_CLIENT_ID=
GOOGLE_MAIL_OAUTH_CLIENT_SECRET=
MICROSOFT_GRAPH_MAIL_OAUTH_CLIENT_ID=
MICROSOFT_GRAPH_MAIL_OAUTH_CLIENT_SECRET=
# Slack is unavailable until app-level OAuth credentials and signing secret are
# configured. Redirect URI: APP_BASE_URL + /api/v1/oauth/callback/slack.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Origin override for the website embed launcher script. Defaults to APP_BASE_URL.
# RADIOSO_WIDGET_ORIGIN=
# Transactional auth email. Use "log" or "noop" locally; use "resend" with
# RESEND_MAIL_API_KEY for hosted delivery.
MAIL_DRIVER=log
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Radioso
RESEND_MAIL_API_KEY=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
# Base URL for anonymous public chat links (e.g., https://yourapp.com/chat)
PUBLIC_CHAT_BASE_URL=http://localhost:3000/chat

# Website crawler request limits. A crawler provider is supplied through
# backend composition.
WEBSITE_CRAWLER_DEFAULT_LIMIT=10
WEBSITE_CRAWLER_MAX_LIMIT=100

# Backend MCP mount. Keep disabled by default so `/mcp` is opt-in.
RADIOSO_MCP_ENABLED=false
# False means same-host backend MCP when RADIOSO_MCP_ENABLED=true.
# True means MCP is served by the standalone `packages/radioso-mcp-server/` process.
RADIOSO_MCP_STANDALONE=false
RADIOSO_MCP_MOUNT_PATH=/mcp
# CORS for the backend merged MCP route. Bearer auth is allowed; credentials are not enabled.
RADIOSO_MCP_MERGED_CORS_ORIGINS=*
# Shared MCP configuration used by the standalone package and backend merged mode.
RADIOSO_MCP_BIND_HOST=127.0.0.1
RADIOSO_MCP_BIND_PORT=8787
RADIOSO_MCP_SERVER_NAME=radioso-context
RADIOSO_MCP_SIGNING_SECRET=
RADIOSO_MCP_REQUEST_TIMEOUT_MS=30000
RADIOSO_MCP_ACCESS_TOKEN_TTL_SECONDS=900
# Comma-separated tool allowlists. Leave blank to use the package defaults.
RADIOSO_MCP_ALLOWED_READ_TOOLS=
RADIOSO_MCP_ALLOWED_WRITE_TOOLS=
# Tools listed here advertise requiresApproval: true so MCP hosts (Cursor, Claude Desktop, ChatGPT) prompt the user before calling them. Not a server-side gate.
RADIOSO_MCP_APPROVAL_REQUIRED_WRITE_TOOLS=
RADIOSO_MCP_AUDIT_LOG_PATH=
# Optional shared runtime store. Leave blank for in-memory single-node mode.
RADIOSO_MCP_REDIS_URL=
RADIOSO_MCP_REDIS_KEY_PREFIX=radioso-mcp
# Optional workspace-specific policy override file. JSON shape:
# {"workspaces":{"<workspace-id>":{"allowedReadTools":["describe_capabilities"],"allowedWriteTools":["create_document"],"approvalRequiredWriteTools":["create_document"]}}}
# approvalRequiredWriteTools tags tools as host-prompt-required; it is not a server-side gate.
RADIOSO_MCP_WORKSPACE_POLICIES_PATH=
