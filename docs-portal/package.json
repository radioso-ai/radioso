{
  "name": "radioso-docs-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm run sync && next dev --webpack --port 3001",
    "build": "pnpm run sync && next build --webpack",
    "preview": "serve out --listen 3000",
    "lint": "eslint .",
    "sync": "pnpm run sync:openapi && pnpm run sync:stoplight",
    "sync:openapi": "node ./scripts/sync-openapi.mjs",
    "sync:stoplight": "node ./scripts/sync-stoplight.mjs"
  },
  "dependencies": {
    "@radioso/ui": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@stoplight/elements": "^9.0.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.6",
    "serve": "^14.2.4",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2"
  }
}
