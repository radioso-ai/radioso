{
  "name": "@radioso/enterprise-embed-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/embed-page.js",
  "types": "./dist/src/embed-page.d.ts",
  "exports": {
    "./embed-page": {
      "types": "./dist/src/embed-page.d.ts",
      "default": "./dist/src/embed-page.js"
    },
    "./embed-layout": {
      "types": "./dist/src/embed-layout.d.ts",
      "default": "./dist/src/embed-layout.js"
    },
    "./routes/embed-session": {
      "types": "./dist/src/routes/embed-session.d.ts",
      "default": "./dist/src/routes/embed-session.js"
    },
    "./routes/radioso-embed-script": {
      "types": "./dist/src/routes/radioso-embed-script.d.ts",
      "default": "./dist/src/routes/radioso-embed-script.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  }
}
