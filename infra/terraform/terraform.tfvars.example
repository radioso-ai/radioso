# Required
environment = "staging"
project_id = "your-gcp-project-id"

# Secrets — set via TF_VAR_* env vars or a .tfvars file NOT committed to git
# openai_api_key           = ""
# session_cookie_secret    = ""
# workspace_token_secret   = ""
# public_chat_session_secret     = ""
# radioso_mcp_signing_secret    = ""
# connector_encryption_key = ""
# resend_mail_api_key      = ""
# mail_from_email       = "noreply@your-verified-domain.example"
# mail_from_name        = "Radioso"
# metrics_auth_token       = ""
# ee_usage_admin_token     = ""   # enables EE usage-limits admin API + operator-console owner bootstrap

# Optional overrides (defaults shown)
# region                  = "us-central1"
# deploy_services         = false
# radioso_edition         = "enterprise"
# backend_image           = "us-central1-docker.pkg.dev/your-project/radioso-staging/backend:latest"
# frontend_image          = "us-central1-docker.pkg.dev/your-project/radioso-staging/frontend:latest"
# worker_min_instances   = 0
# worker_max_instances   = 5
# db_tier                 = "db-f1-micro"
# db_deletion_protection  = false
# backend_min_instances   = 0
# backend_max_instances   = 2
# frontend_min_instances  = 0
# frontend_max_instances  = 2
# worker_task_queue_name  = "radioso-document-processing"
# worker_task_max_dispatches_per_second = 10
# worker_task_max_concurrent_dispatches = 20
# document_processing_job_lease_ms = 300000
# document_worker_recovery_schedule = "0 * * * *"
# crawler_worker_recovery_schedule = "0 3 * * *"
# document_storage_bucket_name = "your-project-radioso-documents"
# document_upload_max_bytes = 10485760
# openai_chat_model       = "gpt-5-mini"
# openai_rerank_model     = "gpt-4.1-mini"
# openai_vector_model     = "text-embedding-3-small"
# session_ttl_hours       = 168
# metrics_enabled         = false
# connector_public_base_url = "https://your-backend-url"
# radioso_mcp_enabled = true
# radioso_mcp_base_url_override = "https://your-backend-url"
# app_base_url_override   = "https://your-public-app-domain.example"
# public_chat_base_url_override = "https://your-public-app-domain.example/chat"
