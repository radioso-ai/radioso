# Canonical local configuration for backend host runs, tests, and Docker Compose.
PORT=8080
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hivec
# Used only by persistence integration tests running on the host.
INTEGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hivec
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_CHAT_MODEL=gpt-5.2
OPENAI_RERANK_MODEL=gpt-5.2
OPENAI_VECTOR_MODEL=text-embedding-3-small
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_CHAT_PROVIDER=
LLM_CHAT_MODEL=
LLM_REWRITE_PROVIDER=
LLM_REWRITE_MODEL=
LLM_RERANK_PROVIDER=
LLM_RERANK_MODEL=
LLM_EMBEDDING_PROVIDER=
LLM_EMBEDDING_MODEL=
SESSION_COOKIE_NAME=hivec_session
SESSION_COOKIE_SECRET=change-me-change-me
SESSION_TTL_HOURS=168
# Connector secret encryption key (32 bytes, base64-encoded).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_ENCRYPTION_KEY=
# Base URL for anonymous public chat links (e.g., https://yourapp.com/chat)
PUBLIC_CHAT_BASE_URL=http://localhost:3000/chat
