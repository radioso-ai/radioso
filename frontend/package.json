{
  "name": "radioso-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync-edition": "if [ ! -f ../scripts/sync-ee-frontend-routes.mjs ]; then :; elif [ \"${RADIOSO_EDITION:-oss}\" = \"enterprise\" ]; then pnpm --dir ../ee run build && node ../scripts/sync-ee-frontend-routes.mjs enable; else node ../scripts/sync-ee-frontend-routes.mjs disable; fi",
    "postinstall": "pnpm run sync-edition",
    "build:routine-definition": "pnpm --dir ../packages/routine-definition run build",
    "build:routine-markdown": "pnpm --dir ../packages/routine-markdown run build",
    "build:workspace-deps": "pnpm run build:routine-definition && pnpm run build:routine-markdown",
    "predev": "pnpm run build:workspace-deps && pnpm run sync-edition",
    "dev": "next dev --webpack --port 3000",
    "prebuild": "pnpm run build:workspace-deps && pnpm run sync-edition",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lexical/react": "^0.45.0",
    "@lexical/rich-text": "^0.45.0",
    "@lexical/utils": "^0.45.0",
    "@radioso/routine-markdown": "workspace:*",
    "@radioso/ui": "workspace:*",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lexical": "^0.45.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shiki": "3.23.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
