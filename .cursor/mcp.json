{
  "mcpServers": {
    "radioso-stdio": {
      "command": "npm",
      "args": [
        "--prefix",
        "packages/radioso-mcp-server",
        "run",
        "-s",
        "cursor:mcp-stdio"
      ],
      "env": {
        "RADIOSO_BASE_URL": "${env:RADIOSO_BASE_URL}",
        "RADIOSO_API_TOKEN": "${env:RADIOSO_API_TOKEN}",
        "RADIOSO_MCP_SERVER_NAME": "${env:RADIOSO_MCP_SERVER_NAME}",
        "RADIOSO_MCP_REQUEST_TIMEOUT_MS": "${env:RADIOSO_MCP_REQUEST_TIMEOUT_MS}"
      }
    },
    "radioso-local": {
      "url": "http://127.0.0.1:8787/mcp",
      "headers": {
        "Authorization": "Bearer ${env:RADIOSO_MCP_ACCESS_TOKEN}"
      }
    }
  }
}
