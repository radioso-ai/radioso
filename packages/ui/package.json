{
  "name": "@radioso/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    "./badge": {
      "types": "./src/badge.tsx",
      "default": "./src/badge.tsx"
    },
    "./button": {
      "types": "./src/button.tsx",
      "default": "./src/button.tsx"
    },
    "./input": {
      "types": "./src/input.tsx",
      "default": "./src/input.tsx"
    },
    "./pagination": {
      "types": "./src/pagination.tsx",
      "default": "./src/pagination.tsx"
    },
    "./dashboard-pagination": {
      "types": "./src/dashboard-pagination.tsx",
      "default": "./src/dashboard-pagination.tsx"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts"
    }
  },
  "peerDependencies": {
    "@radix-ui/react-slot": "*",
    "@types/react": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "react": "*",
    "tailwind-merge": "*"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@types/react": "^19.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "19.2.6",
    "tailwind-merge": "^3.3.1"
  }
}
