backend_image  = "us-central1-docker.pkg.dev/radioso-staging/radioso-staging/backend:latest"
frontend_image = "us-central1-docker.pkg.dev/radioso-staging/radioso-staging/frontend:latest"

# Required secrets: prefer TF_VAR_* in CI instead of committing tfvars.
# openai_api_key           = ""
# session_cookie_secret    = ""
# workspace_token_secret   = ""
# public_chat_session_secret     = ""
# connector_encryption_key = ""
# resend_mail_api_key      = ""
# posthog_api_key          = ""
# mail_from_email       = "noreply@your-verified-domain.example"
# mail_from_name        = "Radioso"

# Optional overrides
# project_id                  = "radioso-staging"
# environment                 = "staging"
# region                      = "us-central1"
# deploy_services             = false
# radioso_edition             = "enterprise"
# db_tier                     = "db-f1-micro"
# backend_max_instances       = 2
# frontend_max_instances      = 2
# worker_max_instances        = 5
# document_storage_bucket_name = "radioso-staging-radioso-staging-documents"
# error_sinks                 = "audit,posthog"
# posthog_host                = "https://us.i.posthog.com"
# radioso_mcp_enabled = true
# app_base_url_override       = "https://your-public-app-domain.example"
# public_chat_base_url_override = "https://your-public-app-domain.example/chat"
# worker_tasks_service_url_override = "https://your-worker-url.a.run.app"

# Ray operator copilot
# copilot_probe_budget_per_turn       = 6    # replayed turns one Ray turn may spend verifying
# copilot_conversation_retention_days = 90   # 0 keeps Ray conversations indefinitely
# copilot_retention_schedule          = "30 4 * * *"

# --- Monitoring and alerting ---
# monitoring_enabled             = true
# monitoring_notification_emails = ["ops@your-domain.example"]
# Slack: create the channel once in Cloud Monitoring (it holds an OAuth token Terraform
# should not keep in state), then paste its ID here.
# monitoring_extra_notification_channel_ids = ["projects/YOUR_PROJECT/notificationChannels/1234567890"]
# container_health_probes_enabled = true

# --- Ops event feed ---
# Add ops_webhook to the sink lists above to push product events and errors out.
# product_analytics_sinks  = "audit,ops_webhook"
# error_sinks              = "audit,ops_webhook"
# ops_event_webhook_url    = "https://hooks.example.com/radioso"
# ops_event_webhook_secret = ""   # prefer TF_VAR_ops_event_webhook_secret in CI
# ops_event_webhook_events = "account.registered,chat.failed"
