{
  "name": "radioso",
  "version": "1.23.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:api-contracts": "pnpm --dir backend run generate:openapi && node scripts/check-api-contracts.mjs",
    "generate:prompts": "node scripts/generate-default-prompts.mjs",
    "check:prompts": "node scripts/generate-default-prompts.mjs --check",
    "ci:local": "bash scripts/local-ci-checks.sh",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "lint:dead-code": "NODE_OPTIONS=--max-old-space-size=8192 knip",
    "lint:dead-code:ci": "node scripts/knip-ratchet.mjs",
    "lint:dead-code:baseline": "node scripts/knip-ratchet.mjs --update"
  },
  "pnpm": {
    "overrides": {
      "@faker-js/faker@<10.5.0": "^10.5.0",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "@sentry/browser": "7.119.1",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@tootallnate/once": "3.0.1",
      "@xmldom/xmldom": "0.9.12",
      "adm-zip@<0.6.1": "^0.6.1",
      "body-parser@<1.20.9": "~1.20.9",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "compression@<1.8.2": "^1.8.2",
      "dompurify@<3.4.17": "^3.4.17",
      "esbuild@<0.28.1": "^0.28.1",
      "file-type": "21.3.2",
      "fast-uri": "3.1.8",
      "hono": "4.13.5",
      "js-cookie": "3.0.7",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash": "4.18.1",
      "postcss": "8.5.23",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs": "6.16.0",
      "react-router": "7.18.2",
      "react-router-dom": "7.18.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "tmp": "0.2.7",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "uuid@<11.1.1": "11.1.1",
      "vite": "7.3.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "knip": "^5.66.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4"
  }
}
