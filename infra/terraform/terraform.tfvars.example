# Required
project_id = "your-gcp-project-id"

# Secrets — set via TF_VAR_* env vars or a .tfvars file NOT committed to git
# openai_api_key           = ""
# session_cookie_secret    = ""
# workspace_token_secret   = ""
# website_embed_secret     = ""
# connector_encryption_key = ""

# Optional overrides (defaults shown)
# region                  = "us-central1"
# deploy_services         = false
# backend_image           = "us-central1-docker.pkg.dev/your-project/radioso/backend:latest"
# frontend_image          = "us-central1-docker.pkg.dev/your-project/radioso/frontend:latest"
# worker_instance_count   = 1
# db_tier                 = "db-f1-micro"
# db_deletion_protection  = false
# backend_min_instances   = 0
# backend_max_instances   = 2
# frontend_min_instances  = 0
# frontend_max_instances  = 2
# document_storage_bucket_name = "your-project-radioso-documents"
# document_upload_max_bytes = 10485760
# openai_chat_model       = "gpt-5-mini"
# openai_rerank_model     = "gpt-4.1-mini"
# openai_vector_model     = "text-embedding-3-small"
# session_ttl_hours       = 168
# connector_public_base_url = "https://your-backend-url"
# public_chat_base_url    = "https://your-frontend-url/chat"
